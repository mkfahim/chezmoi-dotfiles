alias mlcad2026="sudo docker start -ai mlcad2026"


# ── OSIC-TOOLS ────────────────────────────────────────────────

# University environment · Z2A Course by Matt Venn
osic-course() {
    export DOCKER_TAG=2025.07
    export DESIGNS="$HOME/asic"
    export CONTAINER_NAME="iic-osic-tools_xvnc_uid_$(id -u)"

    cd "$HOME/IIC-OSIC-TOOLS" || return

    echo "University OSIC-TOOLS selected: $DOCKER_TAG"
    echo "Designs directory: $DESIGNS"
}

# Newer environment · iic-osic-tools version_2026_10
osic-new() {
    export DOCKER_TAG=2026.10
    export DESIGNS="$HOME/asic-2026.10"
    export CONTAINER_NAME="iic-osic-tools_2026_10"
    export WEBSERVER_PORT=8081
    export VNC_PORT=5902

    cd "$HOME/IIC-OSIC-TOOLS-2026.10" || return

    echo "New OSIC-TOOLS selected: $DOCKER_TAG"
    echo "Designs directory: $DESIGNS"
}


# ── Aliases: Filesystem ────────────────────────────────────────

alias ls="ls -A --color=auto"
alias ll="ls -lah --color=auto"
alias la="ls -la"

alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias back="cd -"
alias home="cd ~"
alias croot="cd /"
alias ctmp="cd /tmp"


# ── Aliases: System ───────────────────────────────────────────

alias df="df -h"
alias free="free -h"
alias ports="ss -tuln"
alias listening="ss -tulpn"
alias myip="hostname -I"
alias sysinfo="uname -a"
alias uptime="uptime -p"
alias meminfo="free -h"


